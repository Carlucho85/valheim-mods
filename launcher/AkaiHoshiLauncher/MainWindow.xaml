<Window x:Class="AkaiHoshiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akai Hoshi | Valheim"
        Width="1040" Height="700" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.88*" />
            <ColumnDefinition Width="1.12*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="22" Background="#111217" Margin="0,0,22,0" ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.34" Center="0.5,0.34" RadiusX="0.84" RadiusY="0.86">
                        <GradientStop Color="#64200F19" Offset="0" />
                        <GradientStop Color="#171116" Offset="0.58" />
                        <GradientStop Color="#101116" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <Ellipse Width="340" Height="340" Fill="#16E21B2D" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <BlurEffect Radius="58" />
                    </Ellipse.Effect>
                </Ellipse>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36">
                    <Border Width="260" Height="384" CornerRadius="16" Background="#08090C" Padding="4">
                        <Image Source="/AkaiHoshiLauncher;component/Assets/logo.png"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="AKAI HOSHI" HorizontalAlignment="Center" Margin="0,22,0,2"
                               FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="CHANGARÖK" HorizontalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                        Background="#281C1F27" CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Valheim · comunidad con mods" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,12,10,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,24">
                <TextBlock Text="AKAI HOSHI" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Bienvenido, vikingo" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Conecta con Changarök y mantén tus mods al día."
                           FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ESTADO DEL MODPACK" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ReleaseStatusText" Text="Buscando la versión más reciente…"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,11,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="InstallPathText" Text="Valheim aún no está localizado"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="BrowseButton" Content="Elegir carpeta de Valheim"
                                Background="{StaticResource PanelLightBrush}" HorizontalAlignment="Left"
                                Margin="0,14,0,0" Padding="13,9" Click="BrowseButton_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Preparando el launcher…"
                                   FontSize="13" TextWrapping="Wrap" />
                        <ProgressBar x:Name="InstallProgressBar" Height="5" Margin="0,13,0,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource AccentBrush}" Background="#282A33"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <Button x:Name="InstallButton" Content="Instalar / actualizar mods"
                        Background="{StaticResource AccentBrush}" FontSize="15" Padding="20,15"
                        Click="InstallButton_Click" />
                <Button x:Name="PlayButton" Content="Jugar a Valheim"
                        Background="{StaticResource PanelLightBrush}" Margin="0,10,0,0"
                        Click="PlayButton_Click" IsEnabled="False" />
            </StackPanel>

            <DockPanel Grid.Row="2" Margin="0,28,0,2">
                <TextBlock Text="Instalación y actualizaciones seguras desde GitHub Releases"
                           FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Content="↻" ToolTip="Comprobar actualizaciones"
                        Background="Transparent" Foreground="{StaticResource MutedBrush}"
                        Padding="10,5" HorizontalAlignment="Right" Click="RefreshButton_Click" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
